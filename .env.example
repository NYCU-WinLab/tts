# --- Deployment (compose) ---
# Image tag: main, sha-<7>, or a release.
TTS_VERSION=main
# Where web listens on the host.
TTS_BIND=127.0.0.1
TTS_PORT=3000
POSTGRES_PASSWORD=

# --- Sign-in ---
# The public URL; also the MCP resource (<url>/mcp), the issuer base and the
# base of the audio links speak returns.
BETTER_AUTH_URL=https://tts.example.com
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# A confidential OIDC client in your Keycloak realm, redirect URI
# <BETTER_AUTH_URL>/api/auth/callback/keycloak. Its service account needs
# realm-management view-users: API keys and MCP stop working for members
# who are disabled in Keycloak.
KEYCLOAK_ISSUER=https://auth.example.com/realms/example
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# --- Worker ---
# The GPU worker's bearer token (openssl rand -hex 32); the same value goes
# in the worker's .env.
WORKER_TOKEN=

# --- Admins ---
# Usernames (comma separated) who may add and delete built-in voices.
TTS_ADMINS=

# --- Observability (optional; off when the endpoint is empty) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
# Authorization=Bearer <token>
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=tts
